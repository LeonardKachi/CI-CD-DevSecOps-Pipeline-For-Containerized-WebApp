# Copy this file to backend.hcl and fill in the values printed by the bootstrap
# step (the "backend_config" output). backend.hcl is ignored by Git.
#
#   terraform init -backend-config=backend.hcl

bucket       = "webapp-2048-tfstate-<YOUR_ACCOUNT_ID>"
key          = "webapp-2048/terraform.tfstate"
region       = "us-east-1"
encrypt      = true
kms_key_id   = "arn:aws:kms:us-east-1:<YOUR_ACCOUNT_ID>:key/<KEY_ID>"
use_lockfile = true
