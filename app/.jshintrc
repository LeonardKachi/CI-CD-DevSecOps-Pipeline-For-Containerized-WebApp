{
    "esnext": true,
    "indent": 2,
    "maxlen": 80,
    "freeze": true,
    "camelcase": true,
    "unused": true,
    "eqnull": true,
    "proto": true,
    "supernew": true,
    "noyield": true,
    "evil": true,
    "node": true,
    "boss": true,
    "expr": true,
    "loopfunc": true,
    "white": true,
    "maxdepth": 4,
    "overrides": {
        "**/js/bind_polyfill.js": {
            "freeze": false
        },
        "**/js/game_manager.js": {
            "maxdepth": 5
        }
    }
}
